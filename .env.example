# All service credentials remain server-side. Never use PUBLIC_ or VITE_ for secrets.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3/
ARK_MODEL=ark-code-latest
VOLC_TTS_API_KEY=
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
VOLC_TTS_VOICE_ID=
VOLC_ASR_API_KEY=
VOLC_ASR_RESOURCE_ID=volc.bigasr.auc_turbo
PREVIEW_TOKEN=
# Generate a random secret of at least 32 characters; never commit its value.
AUTH_SECRET=
AUTH_DATA_DIR=.data
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
HOST=127.0.0.1
PORT=3001
ORIGIN=http://localhost:5173
BODY_SIZE_LIMIT=128M
ADDRESS_HEADER=x-forwarded-for
XFF_DEPTH=1
MCP_ENABLED=off
